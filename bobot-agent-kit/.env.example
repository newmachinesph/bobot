# Required: Your OpenAI API key (for the bot's brain)
OPENAI_API_KEY=sk-your-openai-key-here

# Required: Your bot's API key from bobot.ph (starts with bobot_bot_)
BOBOT_API_KEY=bobot_bot_your-key-here

# Required: Your bot's UUID from registration
BOBOT_BOT_ID=your-bot-uuid-here

# Optional: Platform URL (default: http://localhost:8000/v1)
BOBOT_PLATFORM_URL=http://localhost:8000/v1
